{
  "name": "dmp-cs-madmp-schema-mcp",
  "version": "1.0.0",
  "description": "MCP server for searching maDMP (machine-actionable Data Management Plans) schema definitions",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "madmp-schema-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write '{src,examples}/**/*.{ts,tsx}'",
    "format:check": "prettier --check '{src,examples}/**/*.{ts,tsx}'"
  },
  "keywords": [
    "mcp",
    "madmp",
    "dmp",
    "schema",
    "data-management-plan"
  ],
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.2.3",
    "eslint": "^9.39.2",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.55.0"
  }
}
